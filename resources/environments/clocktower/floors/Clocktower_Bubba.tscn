[sub_resource type="GDScript" id="GDScript_rvwkv"]
resource_name = "BowlingRoom"
script/source = "extends ClocktowerRoom

@export var bowling_pins_sfx : AudioStream

@onready var enemy_group: EnemyGroup = $EnemyGroup

func _ready() -> void:
	super()
	enemy_group.enemies_dead.connect(on_enemies_killed)
	print(\"READY\")


func on_enemies_killed():
	print(\"KLILLED\")
	$StrikeUI/AnimationPlayer.play(\"strike\")
	
	await get_tree().create_timer(1.2, false).timeout
	
	CameraBrain.push_camera_node($CameraNode)
	await get_tree().create_timer(2, false).timeout
	
	var p = GlobalObjectPool.get_object(GlobalObjectPool.PoolObjects.DEATH_PARTICLES)
	p.global_position = $Gate.global_position
	p.scale = Vector3.ONE * 2
	$Gate.queue_free()
	
	await get_tree().create_timer(1.0, false).timeout
	CameraBrain.pop_camera_node()

func e_bowling_pins():
	SfxManager.play(SfxManager.Type.NON_POSITIONAL, self, bowling_pins_sfx)
"

