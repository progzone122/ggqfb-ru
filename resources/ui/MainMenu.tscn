[sub_resource type="GDScript" id="GDScript_hmkhq"]
script/source = "extends Control

signal finished

var fin : bool

func _process(delta: float) -> void:
	if !fin and Input.is_action_just_pressed(\"ui_accept\"):
		fin = true
		var tween = create_tween()
		tween.tween_property(self, \"modulate:a\", 0, 0.2)
		finished.emit()
		await tween.finished
		visible = false
"

